{
  "name": "conductor",
  "version": "0.0.0",
  "type": "module",
  "bin": {
    "conductor": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "unused": "knip",
    "update": "taze --interactive",
    "prepare": "tsup && simple-git-hooks || true"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint && pnpm test",
    "commit-msg": "pnpm commitlint --edit $1"
  },
  "knip": {
    "project": [
      "src/**/*.ts"
    ],
    "ignoreDependencies": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/github"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.30.3",
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "execa": "^9.6.1",
    "gray-matter": "^4.0.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@commitlint/cli": "^20.4.3",
    "@commitlint/config-conventional": "^20.4.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.6",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@types/node": "^25.3.5",
    "knip": "^5.86.0",
    "semantic-release": "^25.0.3",
    "simple-git-hooks": "^2.13.1",
    "taze": "^19.10.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "ultracite": "^7.2.5",
    "vitest": "^4.0.18"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "simple-git-hooks"
    ]
  }
}
